# ---------------------------------------------------------------
# Nehemiah_DNS configuration. Copy to .env (dev) or
# /etc/nehemiah_dns/nehemiah_dns.env (prod, chmod 640 root:nehemiah_dns).
# NEVER commit real values.
# ---------------------------------------------------------------

# --- Storage ---
NEHEMIAH_DB=nehemiah.db
NEHEMIAH_CACHE_DIR=cache
NEHEMIAH_LOCAL_LISTS=lists
NEHEMIAH_RETENTION_DAYS=30

# --- Admin auth (required) ---
# python -m nehemiah_dns gen-secret
NEHEMIAH_SECRET_KEY=
NEHEMIAH_ADMIN_USER=admin
# python -m nehemiah_dns hash-password
NEHEMIAH_ADMIN_PASSWORD_HASH=
# Set to 0 ONLY for local http:// development
NEHEMIAH_COOKIE_SECURE=1
# Set to 1 when behind Caddy/nginx on the same host
NEHEMIAH_TRUST_PROXY=0
NEHEMIAH_PUBLIC_URL=http://127.0.0.1:8080

# --- HTTP check API ---
# If empty, /api/v1/check only answers direct loopback callers.
NEHEMIAH_API_TOKEN=

# --- Remote lists (semicolon separated url|category) ---
NEHEMIAH_SOURCES=https://raw.githubusercontent.com/mystmn/nehemiah-lists/main/ads.txt|ads;https://raw.githubusercontent.com/mystmn/nehemiah-lists/main/malware.txt|malware
NEHEMIAH_ALLOWED_SOURCE_HOSTS=raw.githubusercontent.com
NEHEMIAH_MAX_LIST_BYTES=52428800
NEHEMIAH_FETCH_TIMEOUT=15
NEHEMIAH_RELOAD_INTERVAL=5
# Action for categories seen for the first time: BLOCK | MONITOR | ALLOW
NEHEMIAH_DEFAULT_CATEGORY_ACTION=BLOCK

# --- DNS data plane ---
NEHEMIAH_DNS_HOST=127.0.0.1
NEHEMIAH_DNS_PORT=5353
NEHEMIAH_DNS_UPSTREAM=1.1.1.1
NEHEMIAH_DNS_UPSTREAM_PORT=53
NEHEMIAH_DNS_TIMEOUT=3
# nxdomain | zero (0.0.0.0 / ::)
NEHEMIAH_DNS_BLOCK_MODE=nxdomain
NEHEMIAH_HIT_QUEUE_SIZE=10000

# --- Review e-mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=1
ALERT_FROM=nehemiah_dns@example.com
ALERT_EMAIL=secops@example.com
ALERT_COOLDOWN_SECONDS=3600
