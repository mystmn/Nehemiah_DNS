# ---------------------------------------------------------------
# SentinelDNS configuration. Copy to .env (dev) or
# /etc/sentineldns/sentineldns.env (prod, chmod 640 root:sentineldns).
# NEVER commit real values.
# ---------------------------------------------------------------

# --- Storage ---
SENTINEL_DB=sentinel.db
SENTINEL_CACHE_DIR=cache
SENTINEL_LOCAL_LISTS=lists
SENTINEL_RETENTION_DAYS=30

# --- Admin auth (required) ---
# python -m sentineldns gen-secret
SENTINEL_SECRET_KEY=
SENTINEL_ADMIN_USER=admin
# python -m sentineldns hash-password
SENTINEL_ADMIN_PASSWORD_HASH=
# Set to 0 ONLY for local http:// development
SENTINEL_COOKIE_SECURE=1
# Set to 1 when behind Caddy/nginx on the same host
SENTINEL_TRUST_PROXY=0
SENTINEL_PUBLIC_URL=http://127.0.0.1:8080

# --- HTTP check API ---
# If empty, /api/v1/check only answers direct loopback callers.
SENTINEL_API_TOKEN=

# --- Remote lists (semicolon separated url|category) ---
SENTINEL_SOURCES=https://raw.githubusercontent.com/YOUR_ORG/sentineldns-lists/main/ads.txt|ads;https://raw.githubusercontent.com/YOUR_ORG/sentineldns-lists/main/malware.txt|malware
SENTINEL_ALLOWED_SOURCE_HOSTS=raw.githubusercontent.com
SENTINEL_MAX_LIST_BYTES=52428800
SENTINEL_FETCH_TIMEOUT=15
SENTINEL_RELOAD_INTERVAL=5
# Action for categories seen for the first time: BLOCK | MONITOR | ALLOW
SENTINEL_DEFAULT_CATEGORY_ACTION=BLOCK

# --- DNS data plane ---
SENTINEL_DNS_HOST=127.0.0.1
SENTINEL_DNS_PORT=5353
SENTINEL_DNS_UPSTREAM=1.1.1.1
SENTINEL_DNS_UPSTREAM_PORT=53
SENTINEL_DNS_TIMEOUT=3
# nxdomain | zero (0.0.0.0 / ::)
SENTINEL_DNS_BLOCK_MODE=nxdomain
SENTINEL_HIT_QUEUE_SIZE=10000

# --- Review e-mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=1
ALERT_FROM=sentineldns@example.com
ALERT_EMAIL=secops@example.com
ALERT_COOLDOWN_SECONDS=3600
